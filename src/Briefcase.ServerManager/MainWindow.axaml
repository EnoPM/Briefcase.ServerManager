<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:FluentIcons.Avalonia"
        x:Class="Briefcase.ServerManager.MainWindow"
        Title="Briefcase Server Manager"
        Icon="/Assets/Briefcase.png"
        Width="1240" Height="820" MinWidth="920" MinHeight="640"
        Background="{DynamicResource WindowBrush}">
  <Grid ColumnDefinitions="230,*">
    <Border Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="24,24,20,30" Spacing="1">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Image Source="/Assets/Briefcase.png" Width="32" Height="32"
                   Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="BRIEFCASE" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="SERVER MANAGER" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource MutedTextBrush}"
                     Margin="41,1,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="14,0,14,18" Spacing="5">
          <TextBlock Text="GENERAL" FontSize="10" FontWeight="Bold"
                     Foreground="{DynamicResource MutedTextBrush}"
                     Margin="10,0,10,7" />
          <Button x:Name="HomeNavigation" Classes="navigation">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <icons:FluentIcon Icon="Home" IconSize="Size20" />
              <TextBlock Text="Home" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="AdministrationNavigation" Classes="navigation">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <icons:FluentIcon Icon="PlugConnected" IconSize="Size20" />
              <TextBlock Text="Administration" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBlock Text="CONNECTED SERVER" FontSize="10" FontWeight="Bold"
                     Foreground="{DynamicResource MutedTextBrush}"
                     Margin="10,22,10,7" />
          <Button x:Name="ModsNavigation" Classes="navigation">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <icons:FluentIcon Icon="Apps" IconSize="Size20" />
              <TextBlock Text="Mods" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="ServerNavigation" Classes="navigation">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <icons:FluentIcon Icon="Server" IconSize="Size20" />
              <TextBlock Text="Server" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="ConfigurationNavigation" Classes="navigation">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <icons:FluentIcon Icon="Settings" IconSize="Size20" />
              <TextBlock Text="Configuration" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="BalanceNavigation" Classes="navigation">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <icons:FluentIcon Icon="Scales" IconSize="Size20" />
              <TextBlock Text="Balancing" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border x:Name="ConnectionBadge" Grid.Row="2" Margin="14,12,14,20"
                Padding="12,9" CornerRadius="9"
                Background="{DynamicResource RaisedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <Border x:Name="ConnectionDot" Width="8" Height="8" CornerRadius="4"
                    VerticalAlignment="Center" />
            <TextBlock x:Name="AdminState" Text="Not connected" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
      <Grid Margin="30,20,30,18" ColumnDefinitions="*,Auto" ColumnSpacing="22">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="Bold" />
          <TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource MutedTextBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Column="1" Width="390" Padding="14,11" CornerRadius="10"
                Background="{DynamicResource RaisedSurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
              <icons:FluentIcon Icon="Server" IconSize="Size20"
                                Foreground="{DynamicResource AccentBrush}"
                                VerticalAlignment="Center" />
              <TextBlock x:Name="ServerSummaryName" Grid.Column="1" Text="Server unavailable"
                         FontWeight="Bold" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                          VerticalAlignment="Center">
                <Border x:Name="ServerSummaryDot" Width="8" Height="8" CornerRadius="4" />
                <TextBlock x:Name="ServerSummaryReachability" Text="Offline"
                           FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="16">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:FluentIcon Icon="People" IconSize="Size16" />
                <TextBlock x:Name="ServerSummaryPlayers" Text="— players" FontSize="12" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <icons:FluentIcon Icon="PlayCircle" IconSize="Size16" />
                <TextBlock x:Name="ServerSummaryState" Text="Unknown" FontSize="12" />
              </StackPanel>
              <TextBlock x:Name="ServerSummaryMap" Grid.Column="2" Text="—"
                         FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ServerSummaryPing" Grid.Column="3" Text="— ms"
                         FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock x:Name="ServerSummaryActionState"
                         Foreground="{DynamicResource MutedTextBrush}"
                         FontSize="12" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                <Button x:Name="ServerSummaryStart" Classes="summary-action action-success"
                        Background="{DynamicResource SuccessBrush}" Foreground="White"
                        ToolTip.Tip="Start server" IsVisible="False">
                  <PathIcon Width="20" Height="20" Foreground="White"
                            Data="M8 5 L19 12 L8 19 Z" />
                </Button>
                <Button x:Name="ServerSummaryRestart" Classes="summary-action action-info"
                        Background="{DynamicResource InfoBrush}" Foreground="White"
                        ToolTip.Tip="Restart server" IsVisible="False">
                  <icons:FluentIcon Icon="ArrowSync" IconSize="Size16" />
                </Button>
                <Button x:Name="ServerSummaryShutdown" Classes="summary-action action-danger"
                        Background="{DynamicResource DangerBrush}" Foreground="White"
                        ToolTip.Tip="Shut down server" IsVisible="False">
                  <PathIcon Width="20" Height="20" Foreground="White"
                            Data="M13 3 L11 3 L11 13 L13 13 Z M17.83 5.17 L16.41 6.59 C17.99 7.86 19 9.81 19 12 C19 15.87 15.87 19 12 19 C8.13 19 5 15.87 5 12 C5 9.81 6.01 7.86 7.58 6.58 L6.17 5.17 C4.23 6.82 3 9.26 3 12 C3 16.97 7.03 21 12 21 C16.97 21 21 16.97 21 12 C21 9.26 19.77 6.82 17.83 5.17 Z" />
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <Border x:Name="NoticeBorder" Grid.Row="1" IsVisible="False"
              Margin="30,0,30,16" Padding="13,11" CornerRadius="8">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <icons:FluentIcon x:Name="NoticeIcon" Icon="Info" IconSize="Size20"
                            VerticalAlignment="Center" />
          <TextBlock x:Name="NoticeText" Grid.Column="1" TextWrapping="Wrap"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <ContentControl x:Name="ContentHost" Grid.Row="2" Margin="30,0,30,24" />
    </Grid>
  </Grid>
</Window>
