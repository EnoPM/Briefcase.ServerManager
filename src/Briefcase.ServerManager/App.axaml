<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Briefcase.ServerManager.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#0E0B12" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#141018" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#19151F" />
    <SolidColorBrush x:Key="RaisedSurfaceBrush" Color="#211A29" />
    <SolidColorBrush x:Key="ControlBrush" Color="#27202F" />
    <SolidColorBrush x:Key="BorderBrush" Color="#332A3D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#C47AF2" />
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#352044" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A99DB0" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#27865D" />
    <SolidColorBrush x:Key="InfoBrush" Color="#2877B7" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B54250" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.navigation">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
  </Application.Styles>
</Application>
